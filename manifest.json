{
  "manifest_version": "0.3",
  "name": "art-institute-chicago-mcp-server",
  "display_name": "art-institute-chicago-mcp-server",
  "version": "0.1.1",
  "description": "Search the Art Institute of Chicago collection: artworks, artists, exhibitions, and audio guides.",
  "author": { "name": "cyanheads" },
  "repository": {
    "type": "git",
    "url": "https://github.com/cyanheads/art-institute-chicago-mcp-server"
  },
  "homepage": "https://github.com/cyanheads/art-institute-chicago-mcp-server#readme",
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "typescript",
    "art-institute-of-chicago",
    "artic",
    "art",
    "museum",
    "artwork",
    "art-history",
    "provenance",
    "exhibitions",
    "public-domain",
    "iiif"
  ],
  "server": {
    "type": "node",
    "entry_point": "dist/index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/dist/index.js"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "MCP_AUTH_MODE": "none",
        "NODE_ENV": "production",
        "AIC_CONTACT": "${user_config.AIC_CONTACT}",
        "AIC_REQUESTS_PER_MINUTE": "${user_config.AIC_REQUESTS_PER_MINUTE}"
      }
    }
  },
  "compatibility": {
    "runtimes": { "node": ">=24.0.0" }
  },
  "tools_generated": true,
  "prompts_generated": true,
  "user_config": {
    "AIC_CONTACT": {
      "type": "string",
      "title": "Contact for the Art Institute API",
      "description": "Optional. An email or URL the museum can reach, in printable ASCII, sent in the AIC-User-Agent header. Defaults to the repository URL.",
      "required": false,
      "default": ""
    },
    "AIC_REQUESTS_PER_MINUTE": {
      "type": "string",
      "title": "Requests per minute",
      "description": "Optional. Outbound request budget for api.artic.edu (1-600). Defaults to 50, under the published 60 per minute anonymous limit.",
      "required": false,
      "default": ""
    }
  }
}
